ta() {
  if tmux has-session -t dev 2>/dev/null; then
    tmux attach -t dev
  else
    tmux new-session -s dev -c ~
  fi
}

yeet() {
  BRANCH=$(git branch --show-current)
  git add -A
  git commit -m "$1"
  git push -u origin $BRANCH
}

merged() {
  git checkout main
  git pull
  git branch -d "$1"
}

branch() {
  if [ $# -ne 1 ]; then
    echo "Usage: branch <branch name>"
    return -1
  fi

  BRANCH=$(git branch --show-current)

  if [[ $BRANCH != "main" ]]; then
    read -n 1 -p "Branch off of $BRANCH? (y/n) " CHAR
    echo ""

    if [[ "$CHAR" != "y" ]]; then
      return
    fi
  fi

  git checkout -b "$1" && git push -u origin "$1"
}
